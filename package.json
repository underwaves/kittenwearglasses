{
  "name": "kittenwearglasses",
  "version": "1.0.0",
  "description": "Portfolio website for @kittenwearglasses video editing service",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"client,server\" -c \"magenta,cyan\" \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "wrangler dev",
    "build:client": "vite build",
    "build": "vite build",
    "test": "node --experimental-strip-types --test tests/security-and-calculator.test.mjs",
    "deploy": "npm run build && wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "keywords": [
    "portfolio",
    "video-editing",
    "cloudflare-workers",
    "hono",
    "react",
    "vite"
  ],
  "author": "@kittenwearglasses",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "hono": "^4.13.19",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.163.0"
  }
}
